<Page x:Class="WpfApp1.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF0B242B" Offset="0.203"/>
                <GradientStop Color="#FF1A3F46" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <TextBlock Text="Авторизация" VerticalAlignment="Top" Foreground="White" HorizontalAlignment="Center" Margin="20" Style="{StaticResource HeaderTextStyle}"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Введите логин" Style="{StaticResource BasicTextStyle}" Foreground="White" HorizontalAlignment="Center"/>
            <TextBox x:Name="LoginText" Margin="0,10,0,0" ToolTip="Введите логин" Height="25" Width="150"/>
            <TextBlock Text="Введите пароль" Style="{StaticResource BasicTextStyle}" Foreground="White" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            <PasswordBox x:Name="PasswordText" Margin="0,10,0,0" ToolTip="Введите пароль" Height="25" Width="150"/>
            <Button x:Name="AuthEnterButton" Content="Войти" Margin="0,20,0,0" Padding="5" Background="Gold" FontFamily="Arial" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Нет аккаунта?" Style="{StaticResource BasicTextStyle}" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <Button x:Name="GoToRegistrationButton" Content="Зарегистрироваться" Padding="5" Background="Transparent" FontFamily="Arial" FontSize="16" FontWeight="SemiBold" BorderBrush="Transparent"/>
        </StackPanel>
        
    </Grid>
</Page>
